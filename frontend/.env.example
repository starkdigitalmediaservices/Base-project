# Frontend environment (copy to .env.local or .env). Only VITE_* variables reach the browser —
# never put secrets here.

# Display name used in the header, footer and document titles.
VITE_APP_NAME="Base Project"

# Base URL the browser uses for API calls. Keep "/api/v1" to use the Vite dev proxy (same-origin,
# no CORS needed), or set a full URL such as http://localhost:8000/api/v1 when the backend is
# served from another origin (that origin must then be listed in the backend CORS_ORIGINS).
VITE_API_BASE_URL=/api/v1

# Dev-server only: where the Vite proxy forwards /api requests.
VITE_API_PROXY_TARGET=http://localhost:8000

# Request timeout in milliseconds for API calls.
VITE_API_TIMEOUT_MS=15000
