# Backend settings. Copy to `backend/.env` (never commit `.env`).
# Every variable maps to a field in app/core/config.py (case-insensitive).

# --- Application ---------------------------------------------------------------
APP_NAME="Base Project API"
# development | test | production
APP_ENV=development
API_V1_PREFIX=/api/v1
# Swagger UI at /docs, ReDoc at /redoc (disable in production if the API is private)
ENABLE_DOCS=true

# --- Database (locally installed PostgreSQL; see README.md "PostgreSQL setup") -------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# URL-encode special characters in the password (e.g. @ -> %40, : -> %3A, / -> %2F).
DATABASE_URL=postgresql://base_project:change-me-local-db-password@localhost:5432/base_project
# Seconds to wait for PostgreSQL; the API refuses to start if it is unreachable.
DATABASE_CONNECT_TIMEOUT=5
DATABASE_ECHO=false
# Optional: database used by pytest. Defaults to "<DBNAME>_test" on the same server and is
# created automatically when the user has CREATEDB. Never point it at a database you care about.
# TEST_DATABASE_URL=postgresql://base_project:PASSWORD@localhost:5432/base_project_test

# --- Security ------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_REUSE_GRACE_SECONDS=10
REFRESH_COOKIE_NAME=refresh_token
# false is ONLY for local HTTP development (curl, Safari, LAN IPs). Must be true in production
# (startup fails otherwise) because the cookie then requires HTTPS.
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax

# --- CORS (comma-separated explicit origins; "*" is rejected) -------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Pagination ----------------------------------------------------------------
PAGINATION_DEFAULT_PAGE_SIZE=10
PAGINATION_MAX_PAGE_SIZE=100

# --- Logging -------------------------------------------------------------------
LOG_LEVEL=INFO
# json (production) | console (local development)
LOG_FORMAT=console

# --- Seed (python -m app.scripts.manage seed) -----------------------------------
FIRST_ADMIN_NAME=Administrator
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=change-me-admin-password
